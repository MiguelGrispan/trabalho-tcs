<?xml version="1.0" encoding="UTF-8"?>
<!--
  BPMN 2.0 do processo de negócio do Raio-X Comercial (MA5).
  Abre no https://demo.bpmn.io (arraste o arquivo para a página). A imagem é o raio-x-comercial.png, na mesma pasta.
  Cada passo vem do código: app/streamlit_app.py (tela) e raiox/ia.py (indicadores, Gemini e validador).
-->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definicoes_RaioX"
                  targetNamespace="https://github.com/MiguelGrispan/trabalho-tcs"
                  exporter="Claude Code (conferido no bpmn-js 17.11.1)"
                  exporterVersion="1">

  <bpmn:dataStore id="DataStore_Postgres" name="PostgreSQL" />
  <bpmn:dataStore id="DataStore_Arquivos" name="Arquivos da pasta data" />

  <bpmn:collaboration id="Colaboracao_RaioX">
    <bpmn:participant id="Participante_RaioX" name="Raio-X Comercial" processRef="Processo_RaioX" />
    <bpmn:participant id="Participante_Gemini" name="Google Gemini (API, chamada pelo LangChain)" />
    <bpmn:messageFlow id="Mensagem_Pedido" name="pedido: setor, produto, objetivo, indicadores e marcadores permitidos"
                      sourceRef="Tarefa_Gemini" targetRef="Participante_Gemini" />
    <bpmn:messageFlow id="Mensagem_Resposta" name="resposta: resumo, perguntas e lacunas com marcadores"
                      sourceRef="Participante_Gemini" targetRef="Tarefa_Gemini" />
  </bpmn:collaboration>

  <bpmn:process id="Processo_RaioX" name="Preparar a primeira reunião com uma companhia aberta" isExecutable="false">
    <bpmn:laneSet id="Raias">
      <bpmn:lane id="Raia_Vendedor" name="Vendedor">
        <bpmn:flowNodeRef>Inicio_Reuniao</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Tarefa_Digitar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Tarefa_Escolher</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Tarefa_Ler</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Fim_Preparado</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Raia_Aplicacao" name="Aplicação Raio-X (tela Streamlit e pacote raiox)">
        <bpmn:flowNodeRef>Tarefa_Buscar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Decisao_TemDados</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Tarefa_Aviso</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Fim_SemRaioX</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Tarefa_Calcular</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Decisao_IA</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Tarefa_Gemini</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Erro_Gemini</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Tarefa_SemIA</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Juncao_Texto</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Juncao_Laco</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Tarefa_Conferir</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Decisao_Validador</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Tarefa_Trocar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Tarefa_Remover</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Juncao_Frase</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Decisao_MaisFrases</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Tarefa_Registrar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Tarefa_Mostrar</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Vendedor -->
    <bpmn:startEvent id="Inicio_Reuniao" name="Reunião marcada">
      <bpmn:outgoing>Fluxo_01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Tarefa_Digitar" name="Digitar parte do nome da empresa">
      <bpmn:incoming>Fluxo_01</bpmn:incoming>
      <bpmn:outgoing>Fluxo_02</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Tarefa_Escolher" name="Escolher a empresa e informar o produto e o objetivo">
      <bpmn:incoming>Fluxo_04</bpmn:incoming>
      <bpmn:outgoing>Fluxo_07</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Tarefa_Ler" name="Ler o raio-x e preparar a conversa">
      <bpmn:incoming>Fluxo_25</bpmn:incoming>
      <bpmn:outgoing>Fluxo_26</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="Fim_Preparado" name="Vendedor preparado para a reunião">
      <bpmn:incoming>Fluxo_26</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Aplicação: busca (app/streamlit_app.py, raiox/dados.py) -->
    <bpmn:serviceTask id="Tarefa_Buscar" name="Buscar companhias ativas com indicadores">
      <bpmn:incoming>Fluxo_02</bpmn:incoming>
      <bpmn:outgoing>Fluxo_03</bpmn:outgoing>
      <bpmn:property id="Propriedade_Buscar" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="Leitura_Busca">
        <bpmn:sourceRef>Banco_Busca</bpmn:sourceRef>
        <bpmn:targetRef>Propriedade_Buscar</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Decisao_TemDados" name="Tem dados da empresa?">
      <bpmn:incoming>Fluxo_03</bpmn:incoming>
      <bpmn:outgoing>Fluxo_04</bpmn:outgoing>
      <bpmn:outgoing>Fluxo_05</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Tarefa_Aviso" name="Avisar: nenhuma empresa, banco vazio ou desligado">
      <bpmn:incoming>Fluxo_05</bpmn:incoming>
      <bpmn:outgoing>Fluxo_06</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="Fim_SemRaioX" name="Sem raio-x">
      <bpmn:incoming>Fluxo_06</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Aplicação: indicadores e grupo (raiox/ia.py, montar; raiox/segmentos.py) -->
    <bpmn:scriptTask id="Tarefa_Calcular" name="Montar os 6 indicadores e a posição contra o grupo já calculado">
      <bpmn:incoming>Fluxo_07</bpmn:incoming>
      <bpmn:outgoing>Fluxo_08</bpmn:outgoing>
      <bpmn:property id="Propriedade_Calcular" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="Leitura_Arquivos">
        <bpmn:sourceRef>Arquivos_Indicadores</bpmn:sourceRef>
        <bpmn:targetRef>Propriedade_Calcular</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:scriptTask>

    <!-- Aplicação: texto com ou sem IA (app/streamlit_app.py, gerar_raio_x) -->
    <bpmn:exclusiveGateway id="Decisao_IA" name="IA ligada?">
      <bpmn:incoming>Fluxo_08</bpmn:incoming>
      <bpmn:outgoing>Fluxo_09</bpmn:outgoing>
      <bpmn:outgoing>Fluxo_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Tarefa_Gemini" name="Pedir ao Gemini o texto com marcadores">
      <bpmn:incoming>Fluxo_10</bpmn:incoming>
      <bpmn:outgoing>Fluxo_12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="Erro_Gemini" name="Gemini falhou" attachedToRef="Tarefa_Gemini">
      <bpmn:outgoing>Fluxo_11</bpmn:outgoing>
      <bpmn:errorEventDefinition id="Definicao_Erro_Gemini" />
    </bpmn:boundaryEvent>
    <bpmn:scriptTask id="Tarefa_SemIA" name="Montar o texto sem IA (mesmos números)">
      <bpmn:incoming>Fluxo_09</bpmn:incoming>
      <bpmn:incoming>Fluxo_11</bpmn:incoming>
      <bpmn:outgoing>Fluxo_13</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:exclusiveGateway id="Juncao_Texto">
      <bpmn:incoming>Fluxo_12</bpmn:incoming>
      <bpmn:incoming>Fluxo_13</bpmn:incoming>
      <bpmn:outgoing>Fluxo_14</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Aplicação: validador, item por item: o resumo, cada pergunta e cada lacuna (raiox/ia.py, validar_e_preencher) -->
    <bpmn:exclusiveGateway id="Juncao_Laco">
      <bpmn:incoming>Fluxo_14</bpmn:incoming>
      <bpmn:incoming>Fluxo_21</bpmn:incoming>
      <bpmn:outgoing>Fluxo_15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:scriptTask id="Tarefa_Conferir" name="Conferir o próximo item: o resumo, cada pergunta, cada lacuna">
      <bpmn:incoming>Fluxo_15</bpmn:incoming>
      <bpmn:outgoing>Fluxo_16</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:exclusiveGateway id="Decisao_Validador" name="Passou no validador?">
      <bpmn:incoming>Fluxo_16</bpmn:incoming>
      <bpmn:outgoing>Fluxo_17</bpmn:outgoing>
      <bpmn:outgoing>Fluxo_18</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:scriptTask id="Tarefa_Trocar" name="Trocar os marcadores pelos valores da tabela">
      <bpmn:incoming>Fluxo_17</bpmn:incoming>
      <bpmn:outgoing>Fluxo_19</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:scriptTask id="Tarefa_Remover" name="Remover o item e anotar o motivo">
      <bpmn:incoming>Fluxo_18</bpmn:incoming>
      <bpmn:outgoing>Fluxo_20</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:exclusiveGateway id="Juncao_Frase">
      <bpmn:incoming>Fluxo_19</bpmn:incoming>
      <bpmn:incoming>Fluxo_20</bpmn:incoming>
      <bpmn:outgoing>Fluxo_22</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Decisao_MaisFrases" name="Tem mais itens?">
      <bpmn:incoming>Fluxo_22</bpmn:incoming>
      <bpmn:outgoing>Fluxo_21</bpmn:outgoing>
      <bpmn:outgoing>Fluxo_23</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Aplicação: registro e resultado (app/streamlit_app.py; raiox/dados.py, registrar_consulta) -->
    <bpmn:serviceTask id="Tarefa_Registrar" name="Registrar a consulta (se falhar, só avisa)">
      <bpmn:incoming>Fluxo_23</bpmn:incoming>
      <bpmn:outgoing>Fluxo_24</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="Gravacao_Consulta">
        <bpmn:targetRef>Banco_Consultas</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:task id="Tarefa_Mostrar" name="Mostrar o raio-x: indicadores com fonte, perguntas, lacunas e parecidas">
      <bpmn:incoming>Fluxo_24</bpmn:incoming>
      <bpmn:outgoing>Fluxo_25</bpmn:outgoing>
    </bpmn:task>

    <!-- Dados -->
    <bpmn:dataStoreReference id="Banco_Busca" name="PostgreSQL: empresas e indicadores" dataStoreRef="DataStore_Postgres" />
    <bpmn:dataStoreReference id="Arquivos_Indicadores" name="indicadores.csv e segmentos.csv (K-means e vizinhos)" dataStoreRef="DataStore_Arquivos" />
    <bpmn:dataStoreReference id="Banco_Consultas" name="PostgreSQL: consultas" dataStoreRef="DataStore_Postgres" />
    <bpmn:textAnnotation id="Nota_Dados">
      <bpmn:text>Carregados antes da reunião: a DFP da CVM (carregar_dfp.py e indicadores.py); os grupos pelo K-means e as parecidas pelos vizinhos mais próximos (raiox/segmentos.py).</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Ligacao_Nota_Dados" sourceRef="Nota_Dados" targetRef="Banco_Busca" />
    <bpmn:textAnnotation id="Nota_Gemini">
      <bpmn:text>O Gemini recebe os valores, mas só pode escrever marcadores como {margem_ebit}, nunca números. Se ele falhar (tempo, erro da API ou formato errado), a tela segue sem IA e avisa.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Ligacao_Nota_Gemini" sourceRef="Tarefa_Gemini" targetRef="Nota_Gemini" />
    <bpmn:textAnnotation id="Nota_Validador">
      <bpmn:text>Regra de ouro: o nome da empresa, o produto e o setor voltam a ser marcadores; sai o item com algarismo, número por extenso da lista ou marcador desconhecido, e a pergunta sem indicador de base.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Ligacao_Nota_Validador" sourceRef="Tarefa_Conferir" targetRef="Nota_Validador" />

    <!-- Fluxos -->
    <bpmn:sequenceFlow id="Fluxo_01" sourceRef="Inicio_Reuniao" targetRef="Tarefa_Digitar" />
    <bpmn:sequenceFlow id="Fluxo_02" sourceRef="Tarefa_Digitar" targetRef="Tarefa_Buscar" />
    <bpmn:sequenceFlow id="Fluxo_03" sourceRef="Tarefa_Buscar" targetRef="Decisao_TemDados" />
    <bpmn:sequenceFlow id="Fluxo_04" name="Sim" sourceRef="Decisao_TemDados" targetRef="Tarefa_Escolher" />
    <bpmn:sequenceFlow id="Fluxo_05" name="Não" sourceRef="Decisao_TemDados" targetRef="Tarefa_Aviso" />
    <bpmn:sequenceFlow id="Fluxo_06" sourceRef="Tarefa_Aviso" targetRef="Fim_SemRaioX" />
    <bpmn:sequenceFlow id="Fluxo_07" sourceRef="Tarefa_Escolher" targetRef="Tarefa_Calcular" />
    <bpmn:sequenceFlow id="Fluxo_08" sourceRef="Tarefa_Calcular" targetRef="Decisao_IA" />
    <bpmn:sequenceFlow id="Fluxo_09" name="Não" sourceRef="Decisao_IA" targetRef="Tarefa_SemIA" />
    <bpmn:sequenceFlow id="Fluxo_10" name="Sim" sourceRef="Decisao_IA" targetRef="Tarefa_Gemini" />
    <bpmn:sequenceFlow id="Fluxo_11" sourceRef="Erro_Gemini" targetRef="Tarefa_SemIA" />
    <bpmn:sequenceFlow id="Fluxo_12" sourceRef="Tarefa_Gemini" targetRef="Juncao_Texto" />
    <bpmn:sequenceFlow id="Fluxo_13" sourceRef="Tarefa_SemIA" targetRef="Juncao_Texto" />
    <bpmn:sequenceFlow id="Fluxo_14" sourceRef="Juncao_Texto" targetRef="Juncao_Laco" />
    <bpmn:sequenceFlow id="Fluxo_15" sourceRef="Juncao_Laco" targetRef="Tarefa_Conferir" />
    <bpmn:sequenceFlow id="Fluxo_16" sourceRef="Tarefa_Conferir" targetRef="Decisao_Validador" />
    <bpmn:sequenceFlow id="Fluxo_17" name="Sim" sourceRef="Decisao_Validador" targetRef="Tarefa_Trocar" />
    <bpmn:sequenceFlow id="Fluxo_18" name="Não" sourceRef="Decisao_Validador" targetRef="Tarefa_Remover" />
    <bpmn:sequenceFlow id="Fluxo_19" sourceRef="Tarefa_Trocar" targetRef="Juncao_Frase" />
    <bpmn:sequenceFlow id="Fluxo_20" sourceRef="Tarefa_Remover" targetRef="Juncao_Frase" />
    <bpmn:sequenceFlow id="Fluxo_21" name="Sim" sourceRef="Decisao_MaisFrases" targetRef="Juncao_Laco" />
    <bpmn:sequenceFlow id="Fluxo_22" sourceRef="Juncao_Frase" targetRef="Decisao_MaisFrases" />
    <bpmn:sequenceFlow id="Fluxo_23" name="Não" sourceRef="Decisao_MaisFrases" targetRef="Tarefa_Registrar" />
    <bpmn:sequenceFlow id="Fluxo_24" sourceRef="Tarefa_Registrar" targetRef="Tarefa_Mostrar" />
    <bpmn:sequenceFlow id="Fluxo_25" sourceRef="Tarefa_Mostrar" targetRef="Tarefa_Ler" />
    <bpmn:sequenceFlow id="Fluxo_26" sourceRef="Tarefa_Ler" targetRef="Fim_Preparado" />
  </bpmn:process>

  <!-- Desenho (posições em pixels) -->
  <bpmndi:BPMNDiagram id="Desenho_RaioX">
    <bpmndi:BPMNPlane id="Plano_RaioX" bpmnElement="Colaboracao_RaioX">
      <bpmndi:BPMNShape id="Participante_RaioX_di" bpmnElement="Participante_RaioX" isHorizontal="true">
        <dc:Bounds x="100" y="80" width="2180" height="560" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Raia_Vendedor_di" bpmnElement="Raia_Vendedor" isHorizontal="true">
        <dc:Bounds x="130" y="80" width="2150" height="170" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Raia_Aplicacao_di" bpmnElement="Raia_Aplicacao" isHorizontal="true">
        <dc:Bounds x="130" y="250" width="2150" height="390" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Participante_Gemini_di" bpmnElement="Participante_Gemini" isHorizontal="true">
        <dc:Bounds x="100" y="730" width="2180" height="70" />
      </bpmndi:BPMNShape>

      <!-- Vendedor -->
      <bpmndi:BPMNShape id="Inicio_Reuniao_di" bpmnElement="Inicio_Reuniao">
        <dc:Bounds x="165" y="147" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="140" y="188" width="86" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Tarefa_Digitar_di" bpmnElement="Tarefa_Digitar">
        <dc:Bounds x="250" y="125" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Tarefa_Escolher_di" bpmnElement="Tarefa_Escolher">
        <dc:Bounds x="505" y="125" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Tarefa_Ler_di" bpmnElement="Tarefa_Ler">
        <dc:Bounds x="2010" y="125" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Fim_Preparado_di" bpmnElement="Fim_Preparado">
        <dc:Bounds x="2192" y="147" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="2175" y="188" width="70" height="40" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- Aplicação: busca -->
      <bpmndi:BPMNShape id="Tarefa_Buscar_di" bpmnElement="Tarefa_Buscar">
        <dc:Bounds x="250" y="290" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Decisao_TemDados_di" bpmnElement="Decisao_TemDados" isMarkerVisible="true">
        <dc:Bounds x="400" y="305" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="440" y="362" width="60" height="40" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Tarefa_Aviso_di" bpmnElement="Tarefa_Aviso">
        <dc:Bounds x="360" y="440" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Fim_SemRaioX_di" bpmnElement="Fim_SemRaioX">
        <dc:Bounds x="407" y="562" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="450" y="573" width="55" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Banco_Busca_di" bpmnElement="Banco_Busca">
        <dc:Bounds x="290" y="440" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="185" y="452" width="100" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- Aplicação: indicadores -->
      <bpmndi:BPMNShape id="Tarefa_Calcular_di" bpmnElement="Tarefa_Calcular">
        <dc:Bounds x="505" y="290" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Arquivos_Indicadores_di" bpmnElement="Arquivos_Indicadores">
        <dc:Bounds x="545" y="440" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="520" y="495" width="100" height="54" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Nota_Dados_di" bpmnElement="Nota_Dados">
        <dc:Bounds x="160" y="548" width="240" height="84" />
      </bpmndi:BPMNShape>

      <!-- Aplicação: IA -->
      <bpmndi:BPMNShape id="Decisao_IA_di" bpmnElement="Decisao_IA" isMarkerVisible="true">
        <dc:Bounds x="660" y="305" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="657" y="282" width="56" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Tarefa_Gemini_di" bpmnElement="Tarefa_Gemini">
        <dc:Bounds x="620" y="440" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Erro_Gemini_di" bpmnElement="Erro_Gemini">
        <dc:Bounds x="732" y="422" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="772" y="448" width="70" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Tarefa_SemIA_di" bpmnElement="Tarefa_SemIA">
        <dc:Bounds x="780" y="290" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Juncao_Texto_di" bpmnElement="Juncao_Texto" isMarkerVisible="true">
        <dc:Bounds x="940" y="305" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Nota_Gemini_di" bpmnElement="Nota_Gemini">
        <dc:Bounds x="790" y="540" width="250" height="84" />
      </bpmndi:BPMNShape>

      <!-- Aplicação: validador -->
      <bpmndi:BPMNShape id="Juncao_Laco_di" bpmnElement="Juncao_Laco" isMarkerVisible="true">
