# Segredos: a chave do Gemini nunca vai para o Git
.env
.env.*
!.env.example
.streamlit/secrets.toml

# Dados da CVM e tudo que é gerado: ficam só no computador de cada um
data/*
!data/.gitkeep
anomalias.csv
auditoria_ia.csv
resultado_checagem.txt
# Banco, zips da CVM e parquet salvos fora de data/ também não entram
*.db
*.zip
*.parquet

# Ambientes Python e caches (recriados sozinhos)
.venv/
venv/
env/
myenv/
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/

# Terraform: o estado pode guardar a chave em texto puro
.terraform/
*.tfstate
*.tfstate.*
*.tfvars

# Sistema e editores
.DS_Store
.idea/
.vscode/
