# Copie este arquivo para .env (na raiz do repositório) e cole a sua chave do Google AI Studio.
# Ou dê dois cliques em aprender/atalhos/configurar_chave.command, que cria o .env para você.
# O .env nunca vai para o Git.
GOOGLE_API_KEY=

# Endereço do PostgreSQL, com a sua senha (troque SUA_SENHA). Sem estas linhas, o código usa a senha "postgres".
DATABASE_URL=postgresql://postgres:SUA_SENHA@localhost:5432/raiox
TEST_DATABASE_URL=postgresql://postgres:SUA_SENHA@localhost:5432/raiox_teste
